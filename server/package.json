{
  "name": "beacon-server",
  "version": "1.0.0",
  "description": "Beacon — API ระบบจัดเวร รปภ. (Express + MySQL)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
