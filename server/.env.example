# ---------- คัดลอกเป็น .env แล้วแก้ค่า ----------
PORT=5000
NODE_ENV=development            # ใช้งานจริงตั้งเป็น production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workshop_map

# กุญแจเซ็น token: ข้อความสุ่มยาว 32 ตัวขึ้นไป (production จะไม่ยอมเปิดถ้าสั้นหรือยังเป็นค่าตัวอย่าง)
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# หน้าเว็บที่อนุญาตให้เรียก API (ใส่หลายที่คั่นด้วยจุลภาค เช่น เปิดจากมือถือในวงแลน)
CLIENT_URL=http://localhost:5173

# cookie แบบ Secure (ส่งเฉพาะ https) ค่าเริ่มต้น: เปิดเมื่อ NODE_ENV=production
# COOKIE_SECURE=true

# อยู่หลัง reverse proxy (nginx, Render, Railway ฯลฯ) ให้เปิด เพื่อจำกัดการเดารหัสตาม IP จริง
# TRUST_PROXY=true

# ล็อกอินผิดได้กี่ครั้งต่อชื่อผู้ใช้ ภายใน 15 นาที
# LOGIN_MAX_TRIES=5

# เข้ากะต้องเปิด GPS และอยู่ในระยะของจุดเวร (on)
# ปิด (off) ไว้ทดสอบบนคอม หรือมือถือที่เปิดเว็บแบบ http ซึ่งเบราว์เซอร์ไม่ให้อ่านตำแหน่ง
CHECKIN_GPS=on
